#!name = 番茄小说去广告（仅番茄生效）
#!desc = 只拦截番茄小说 com.dragon.read 的穿山甲 / 巨量广告请求；抖音、今日头条、飞书等其他头条系 App 的请求一律原样放行
#!author = cd20230101-debug
#!homepage = https://github.com/cd20230101-debug/myxuexinwang
#!icon = https://raw.githubusercontent.com/deezertidal/private/main/icons/fanqie.png
#!date = 2026-11-06
#!tag = 广告拦截,小说
#!loon_version = 3.5.1(978)

[Rewrite]
# 所有规则都带同一个前置条件：请求的 User-Agent 必须是番茄小说。
# 抖音 / 今日头条 / 飞书等 App 的 UA 不含 com.dragon.read，规则不会命中，连响应都不会改。
# ① 穿山甲（Pangle）：广告拉取、素材、统计接口
request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*(pangolin-sdk-toutiao(-b)?\.com|pglstatp-toutiao\.com|pangle\.io)[^\/]*\//i then reject(204)

# ② 巨量引擎 Gromore 聚合广告
request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*gromore\.zijieapi\.com[^\/]*\//i then reject(204)

# ③ 广告安装包下载（穿山甲下载类广告）
request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*gurd\.snssdk\.com[^\/]*\//i then reject(204)

# ④ 广告图片与素材 CDN
request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*(p6-ad-sign\.byteimg\.com|p9-ad-sign\.byteimg\.com|sf3-ttcdn-tos\.pstatp\.com|activity-ag\.awemeughun\.com)[^\/]*\//i then reject(204)

# ⑤ 其他已知的字节广告 SDK 域名
request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*(byteorge\.com|bytegoofy\.com)[^\/]*\//i then reject(204)

# ===== 可选增强：共享 CDN 上的广告素材，默认关闭 =====
# 打开后 MITM 范围会扩大到 *.pstatp.com / *.snssdk.com，可能影响抖音、今日头条的图片和视频加载，
# 与「绝不影响其他头条系 App」冲突，所以默认注释掉。需要时去掉注释并同步补 [MITM]。
# request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*\.pstatp\.com\/(obj|img)\/(ad|ad-app-package|ad-pattern|web\.business\.image)\//i then reject(204)
# request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*\.snssdk\.com\/(api\/ad|video\/play\/1\/toutiao)\//i then reject(204)
# request if ${request.header['User-Agent']} ~= /(com\.dragon\.read|fanqienovel|novelapp|fqnovel)/i && ${url} ~= /^https?:\/\/[^\/]*\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\//i then reject(204)

[MITM]
hostname = *.pangolin-sdk-toutiao.com, pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao-b.com, pangolin-sdk-toutiao-b.com, *.pglstatp-toutiao.com, pglstatp-toutiao.com, *.pangle.io, pangle.io, gromore.zijieapi.com, gurd.snssdk.com, p6-ad-sign.byteimg.com, p9-ad-sign.byteimg.com, sf3-ttcdn-tos.pstatp.com, activity-ag.awemeughun.com, *.byteorge.com, byteorge.com, *.bytegoofy.com, bytegoofy.com
